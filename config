name                        : Total.js Totem
version                     : 0.1.8
$api                        : /api/

// The address the server listens on. Only this computer by default; anything else (0.0.0.0 in the Docker image) needs `token`, and the server refuses to start without one
$ip                         : 127.0.0.1
$tmsmaxsize                 : 0

// Totem as an MCP server (POST /$mcp/): other agents can list projects and sessions and send prompts. Off by default. With a token it asks for
// `Authorization: Bearer <token>`; without one only programs of this computer (localhost) are accepted, never a web page.
$mcp                        : false

// A random secret is generated and saved in the data folder on first start when empty
secret                      :

// When set, every request must send it (header x-token or the cookie created by /auth/)
token                       :

// A file with the access token (a Docker secret), read when `token` is empty
tokenfile                   :

// Temperature for the models that run on this computer (a low one keeps a small model to the instructions). Remote providers use their own.
temperature       (Number)  : 0.2

// Ollama is asked for a context of at least this many tokens, and for more when the request needs it, up to the second number or the window of the
// model. Its default context is 2048 or 4096 tokens, which cuts the instructions of Totem.
ollamactx         (Number)  : 16384
ollamactxmax      (Number)  : 32768

// A small model can fall into a loop and repeat a paragraph until the context is full. Ollama is asked to penalize repeating (1 is off) and to stop one
// answer after this many tokens (0 is no limit).
ollamarepeat      (Number)  : 1.1
ollamapredict     (Number)  : 8192
// The same limit for a model of up to 4 billion parameters (qwen2.5:1.5b, llama3.2:3b), which tends to write a list that never ends
ollamapredictsmall (Number) : 2560

// Agent limits
maxsteps          (Number)  : 50
bashtimeout       (Number)  : 120000
maxoutput         (Number)  : 30000
contextlimit      (Number)  : 100000
retries           (Number)  : 3
// A new session starts with "Auto-accept edits" ticked (write, edit and patch are not asked; a command and a download always are). Off by default: turn it on in Settings for all projects or for one.
autoaccept                  : false
retrybase         (Number)  : 1000

// Totem writes Total.js unless the project is clearly something else: auto, always or never
totaljs                     : auto

// The knowledge that Totem brings to Total.js 5 projects: its recipes, its library and the check of the conventions.
// The library of Totem: the Total.js knowledge repository (conventions, questions and answers, tested applications, the catalogue of components and icons),
// read live from its llms.txt with a GET. The pages that match a request go in front of the model. false turns it off. libraryurl is where it is.
library                     : true
libraryurl                  : https://raw.githubusercontent.com/totaljs-es/knowledge/main
// libraryanswers: a question gets the one answer of the library that matches it instead of the pages: the words of the question find a few candidates
// and the model of the session chooses the right one by its question (librarychoose). Off by default until it answers better than the pages.
libraryanswers              : false
librarychoose               : true
// The recipes of Totem (private/recipes) that go in front of the model for a request about Total.js 5: how many at most, and false to turn them off
recipes                     : true
reciperesults     (Number)  : 2

// The code in the answer of the model is checked against the conventions (syntax, style, invented functions) and the model corrects it once. false turns it off.
selfcheck                   : true
// The correction of the code is asked from a model of up to 4 billion parameters too (it fixed the indentation in 3 more cases of 29); false leaves it out.
selfchecksmall              : true
// How many pages of the knowledge are read for a prompt, and how many characters of each
forgepages        (Number)  : 2
forgechars        (Number)  : 3500

// Forge (forge.totaljs.es), the documentation site of Total.js in Spanish, as one more source: off by default, because the library has what Totem needs.
// true ranks its pages together with the ones of the library. Useful with other models, or for the products that the library does not cover yet.
forge                       : false
// With forge on, its documents (llms.txt and the pages in Markdown) are read directly, with no MCP server: false goes back to the MCP server only. forgeurl is where Forge is.
forgedocs                   : true
forgeurl                    : https://forge.totaljs.es
// The MCP server of Forge (its tools search, read and verify names) is started only when forge and this are true, and it asks permission once.
forgemcp                    : false

// Totem 4B on this computer (Settings > Totem 4B): Totem downloads the model and llama.cpp, checks both and starts llama-server on 127.0.0.1 at this
// port. llamaserver is a llama-server of your own instead of the one installed on this computer or downloaded. false does not start it with Totem.
localmodel                  : true
localmodelport    (Number)  : 8091
llamaserver                 :
conventions                 : true

// Run the formatter of the project (a local prettier, gofmt, rustfmt, ruff or .totem/formatters.json) after a file is written
formatter                   : true

// Run the checks of the project (node --check, a local tsc, go vet, cargo check, ruff or .totem/diagnostics.json) after a file is written and tell the model what is wrong
diagnostics                 : true

// The shell of the interactive terminal (empty: the SHELL of the user, or /bin/sh)
terminalshell               : 
